{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wasm-oj-forge-production",
  "main": "./worker/cutover-maintenance.ts",
  "compatibility_date": "2026-08-09",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false, "persist": true },
    "traces": { "enabled": false, "head_sampling_rate": 0, "persist": false }
  }
}
