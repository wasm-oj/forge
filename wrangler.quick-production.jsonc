{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wasm-oj-forge-production",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    { "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }
  ],
  "workers_dev": true,
  "preview_urls": false,
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false,
      "persist": true
    },
    "traces": { "enabled": false, "head_sampling_rate": 0, "persist": false }
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "vars": {
    "ENVIRONMENT": "production",
    "PUBLIC_ORIGIN": "https://wasm-oj-forge-production.jacob.workers.dev",
    "FORGE_RELEASE_ID": "201e930e-3a9f-4b2c-85df-6fee69ab8771",
    "FORGE_RELEASE_MANIFEST_SHA256": "57de7f976dae7e0ea6e747a8d2c178814b952c555f9b699066e16b9ec95f8265",
    "GITHUB_OAUTH_CLIENT_ID": "Ov23limRaIiQdRQ3xoyd",
    "GITHUB_APP_ID": "4536310",
    "GITHUB_APP_SLUG": "wasm-oj-forge-production-import",
    "STAGING_ALLOWED_GITHUB_USER_IDS": "",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEK7LyDZPnNn0iTL",
    "OFFICIAL_GITHUB_REPOSITORY_ID": "1328710736"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wasm-oj-core-production",
      "database_id": "68f58868-311b-4a5b-9337-c1a5af88e954",
      "migrations_dir": "migrations/core"
    }
  ],
  "r2_buckets": [
    { "binding": "JUDGE_BUCKET", "bucket_name": "wasm-oj-judge-production" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SUBMISSION_CONTAINER", "class_name": "SubmissionJudgeContainer" },
      { "name": "VALIDATION_CONTAINER", "class_name": "ValidationJudgeContainer" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SubmissionDO",
        "ProblemLeaderboardDO",
        "ContestDO",
        "UserQuotaDO",
        "AdmissionControlDO",
        "SubmissionJudgeContainer",
        "ValidationJudgeContainer"
      ]
    },
    {
      "tag": "v2",
      "deleted_classes": [
        "SubmissionDO",
        "ProblemLeaderboardDO",
        "ContestDO",
        "UserQuotaDO",
        "AdmissionControlDO"
      ]
    }
  ],
  "workflows": [
    {
      "name": "wasm-oj-submission-production",
      "binding": "SUBMISSION_WORKFLOW",
      "class_name": "SubmissionWorkflow"
    },
    {
      "name": "wasm-oj-validation-production",
      "binding": "VALIDATION_WORKFLOW",
      "class_name": "ValidationWorkflow"
    }
  ],
  "containers": [
    {
      "name": "wasm-oj-submission-production",
      "class_name": "SubmissionJudgeContainer",
      "image": "registry.cloudflare.com/b1c3d1b89f9131a84a0f1f6a973232f1/forge-judge-production:201e930e-3a9f-4b2c-85df-6fee69ab8771",
      "instance_type": "standard-2",
      "max_instances": 50,
      "ssh": { "enabled": false }
    },
    {
      "name": "wasm-oj-validation-production",
      "class_name": "ValidationJudgeContainer",
      "image": "registry.cloudflare.com/b1c3d1b89f9131a84a0f1f6a973232f1/forge-judge-production:201e930e-3a9f-4b2c-85df-6fee69ab8771",
      "instance_type": "standard-2",
      "max_instances": 5,
      "ssh": { "enabled": false }
    }
  ],
  "triggers": { "crons": ["* * * * *"] }
}
