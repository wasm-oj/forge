+import org.teavm.tooling.*;
+import org.teavm.vm.TeaVMOptimizationLevel;
+import java.io.File;
+import java.util.Arrays;
+public class BuildJavaGcCompiler {
+ public static void main(String[] args) throws Exception {
+  var tool=new TeaVMTool();
+  tool.setMainClass("org.teavm.javac.CompilerLib");
+  tool.setTargetType(TeaVMTargetType.WEBASSEMBLY_GC);
+  tool.setOptimizationLevel(TeaVMOptimizationLevel.ADVANCED);
+  tool.setObfuscated(false);
+  tool.setStrict(false);
+  tool.setDebugInformationGenerated(true);
+  tool.setClassPath(Arrays.stream(System.getProperty("java.class.path").split(File.pathSeparator)).map(File::new).toList());
+  tool.setTargetDirectory(new File(args[0]));
+  tool.setTargetFileName("java-compiler.wasm");
+  tool.setLog(new ConsoleTeaVMToolLog(true));
+  tool.generate();
+  for(var p:tool.getProblemProvider().getProblems()) {var text=new org.teavm.diagnostics.DefaultProblemTextConsumer();p.render(text);System.err.println(text.getText()+" at "+p.getLocation().getMethod()+" params "+java.util.Arrays.toString(p.getParams()));}
+  if(!tool.getProblemProvider().getSevereProblems().isEmpty())System.exit(1);
+ }
+}
