index 0000000..25c0e16
--- /dev/null
+++ b/compiler/src/test/java/UnicodeRleRegression.java
@@ -0,0 +1,26 @@
+import java.util.Arrays;
+import org.teavm.classlib.impl.unicode.UnicodeHelper;
+
+public final class UnicodeRleRegression {
+    private static void roundTrip(byte[] input) {
+        var restored = new byte[input.length];
+        for (var range : UnicodeHelper.extractRle(UnicodeHelper.compressRle(input))) {
+            if (range.end - range.start != range.data.length) throw new AssertionError("Invalid range");
+            System.arraycopy(range.data, 0, restored, range.start, range.data.length);
+        }
+        if (!Arrays.equals(input, restored)) throw new AssertionError("Unicode category ranges shifted or truncated");
+    }
+    public static void main(String[] args) {
+        for (int length : new int[] {0, 1, 2, 79, 80, 127, 128, 16383, 16384, 16385, 40000}) {
+            var input = new byte[length];
+            Arrays.fill(input, (byte) 5);
+            roundTrip(input);
+        }
+        var mixed = new byte[70000];
+        Arrays.fill(mixed, 100, 35000, (byte) 5);
+        Arrays.fill(mixed, 36000, 69999, (byte) 9);
+        mixed[69999] = 7;
+        roundTrip(mixed);
+        System.out.println("Unicode RLE regression: 12 passed");
+    }
+}
