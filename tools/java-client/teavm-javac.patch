@@ -0,0 +1,29 @@
+package org.teavm.javac;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+
+public final class WasiCompilerMainTest {
+    public static void main(String[] args) throws Exception {
+        assert WasiCompilerMain.run(new String[0]) == 2;
+        assert WasiCompilerMain.run(new String[] {"missing-sdk", "missing-runtime", "Main", "app.wasm", "Main.java"}) == 3;
+        var root = Files.createTempDirectory("java-compiler-status");
+        var source = root.resolve("Main.java");
+        var output = root.resolve("app.wasm");
+        Files.writeString(source, "class Main { public static void main(String[] args) { syntax error } }");
+        var compilerArgs = new String[] {args[0], args[1], "Main", output.toString(), source.toString()};
+        assert WasiCompilerMain.run(compilerArgs) == 1;
+        assert !Files.exists(output);
+        Files.writeString(source, "class Main { public static void main(String[] args) { System.out.println(42); } }");
+        int code = WasiCompilerMain.run(compilerArgs);
+        assert code == 0 : "valid source exit " + code;
+        assert Files.size(output) > 8;
+        Files.deleteIfExists(root.resolve("app.wasm.wast"));
+        Files.delete(output);
+        compilerArgs[2] = "MissingMain";
+        assert WasiCompilerMain.run(compilerArgs) == 2;
+        assert !Files.exists(output);
+        Files.delete(source);
+        Files.delete(root);
+    }
+}
