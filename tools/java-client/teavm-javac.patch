+package org.teavm.hppc;
+
+import java.util.Arrays;
+import java.util.Iterator;
+import java.util.NoSuchElementException;
+import org.teavm.hppc.cursors.IntCursor;
+import org.teavm.hppc.predicates.IntPredicate;
+import org.teavm.hppc.procedures.IntProcedure;
+
+/**
+ * Small bootstrap-safe replacement for relocated HPPC's IntHashSet.
+ *
+ * The standard HPPC implementation wraps its first array allocation in an
+ * OutOfMemoryError handler. That handler currently loses the successful array
+ * assignment in the WASI compiler binary, leaving keys null. This version
+ * keeps the same public surface while using a simple open-addressed table.
+ */
+public class IntHashSet extends AbstractIntCollection
+        implements IntLookupContainer, IntSet, Preallocable, Cloneable, Accountable {
+    public int[] keys;
+    private int size;
+    private int assigned;
+    private boolean hasEmptyKey;
+    private double loadFactor;
+
+    public IntHashSet() {
+        this(4, 0.75);
+    }
+
+    public IntHashSet(int expectedElements) {
+        this(expectedElements, 0.75);
+    }
+
+    public IntHashSet(int expectedElements, double loadFactor) {
+        if (loadFactor <= 0 || loadFactor >= 1) {
+            throw new IllegalArgumentException();
+        }
+        this.loadFactor = loadFactor;
+        ensureCapacity(expectedElements);
+    }
+
+    public IntHashSet(IntContainer container) {
+        this(container.size());
+        addAll(container);
+    }
+
+    @Override
+    public boolean add(int value) {
+        if (value == 0) {
+            if (hasEmptyKey) {
+                return false;
+            }
+            hasEmptyKey = true;
+            size++;
+            return true;
+        }
+        ensureCapacity(size + 1);
+        int slot = slot(value);
+        while (keys[slot] != 0) {
+            if (keys[slot] == value) {
+                return false;
+            }
+            slot = (slot + 1) & (keys.length - 1);
+        }
+        keys[slot] = value;
+        assigned++;
+        size++;
+        return true;
+    }
+
+    public final int addAll(int... values) {
+        int added = 0;
+        ensureCapacity(size + values.length);
+        for (int value : values) {
+            if (add(value)) {
+                added++;
+            }
+        }
+        return added;
+    }
+
+    @Override
+    public int addAll(IntContainer container) {
+        int added = 0;
+        ensureCapacity(size + container.size());
+        for (IntCursor cursor : container) {
+            if (add(cursor.value)) {
+                added++;
+            }
+        }
+        return added;
+    }
+
+    public int addAll(Iterable<? extends IntCursor> cursors) {
+        int added = 0;
+        for (IntCursor cursor : cursors) {
+            if (add(cursor.value)) {
+                added++;
+            }
+        }
+        return added;
+    }
+
+    @Override
+    public int[] toArray() {
+        int[] result = new int[size];
+        int index = 0;
+        if (hasEmptyKey) {
+            result[index++] = 0;
+        }
+        for (int key : keys) {
+            if (key != 0) {
+                result[index++] = key;
+            }
+        }
+        return result;
+    }
+
+    public boolean remove(int value) {
+        if (value == 0) {
+            if (!hasEmptyKey) {
+                return false;
+            }
+            hasEmptyKey = false;
+            size--;
+            return true;
+        }
+        if (keys == null) {
+            return false;
+        }
+        int slot = slot(value);
+        while (keys[slot] != 0) {
+            if (keys[slot] == value) {
+                keys[slot] = 0;
+                assigned--;
+                size--;
+                rehash();
+                return true;
+            }
+            slot = (slot + 1) & (keys.length - 1);
+        }
+        return false;
+    }
+
+    @Override
+    public int removeAll(int value) {
+        return remove(value) ? 1 : 0;
+    }
+
+    @Override
+    public int removeAll(IntPredicate predicate) {
+        int removed = 0;
+        if (hasEmptyKey && predicate.apply(0)) {
+            hasEmptyKey = false;
+            size--;
+            removed++;
+        }
+        for (int i = 0; i < keys.length; ++i) {
+            if (keys[i] != 0 && predicate.apply(keys[i])) {
+                keys[i] = 0;
+                assigned--;
+                size--;
+                removed++;
+            }
+        }
+        if (removed > 0) {
+            rehash();
+        }
+        return removed;
+    }
+
+    @Override
+    public boolean contains(int value) {
+        if (value == 0) {
+            return hasEmptyKey;
+        }
+        if (keys == null) {
+            return false;
+        }
+        int slot = slot(value);
+        while (keys[slot] != 0) {
+            if (keys[slot] == value) {
+                return true;
+            }
+            slot = (slot + 1) & (keys.length - 1);
+        }
+        return false;
+    }
+
+    @Override
+    public void clear() {
+        Arrays.fill(keys, 0);
+        size = 0;
+        assigned = 0;
+        hasEmptyKey = false;
+    }
+
+    @Override
+    public void release() {
+        keys = null;
+        size = 0;
+        assigned = 0;
+        hasEmptyKey = false;
+    }
+
+    @Override
+    public boolean isEmpty() {
+        return size == 0;
+    }
+
+    @Override
+    public void ensureCapacity(int expectedElements) {
+        int required = Math.max(1, expectedElements);
+        if (keys != null && required <= (int) (keys.length * loadFactor)) {
+            return;
+        }
+        int capacity = 1;
+        while (capacity * loadFactor < required) {
+            capacity <<= 1;
+        }
+        int[] oldKeys = keys;
+        keys = new int[capacity];
+        assigned = 0;
+        if (oldKeys != null) {
+            for (int value : oldKeys) {
+                if (value != 0) {
+                    insert(value);
+                }
+            }
+        }
+    }
+
+    @Override
+    public int size() {
+        return size;
+    }
+
+    @Override
+    public Iterator<IntCursor> iterator() {
+        int[] values = toArray();
+        return new Iterator<>() {
+            private int index;
+            private final IntCursor cursor = new IntCursor();
+
+            @Override
+            public boolean hasNext() {
+                return index < values.length;
+            }
+
+            @Override
+            public IntCursor next() {
+                if (!hasNext()) {
+                    throw new NoSuchElementException();
+                }
+                cursor.index = index;
+                cursor.value = values[index++];
+                return cursor;
+            }
+        };
+    }
+
+    @Override
+    public <T extends IntProcedure> T forEach(T procedure) {
+        for (int value : toArray()) {
+            procedure.apply(value);
+        }
+        return procedure;
+    }
+
+    @Override
+    public <T extends IntPredicate> T forEach(T predicate) {
+        for (int value : toArray()) {
+            predicate.apply(value);
+        }
+        return predicate;
+    }
+
+    public static IntHashSet from(int... values) {
+        IntHashSet result = new IntHashSet(values.length);
+        result.addAll(values);
+        return result;
+    }
+
+    public int indexOf(int value) {
+        if (value == 0) {
+            return hasEmptyKey ? 0 : -1;
+        }
+        if (keys == null) {
+            return -1;
+        }
+        int slot = slot(value);
+        while (keys[slot] != 0) {
+            if (keys[slot] == value) {
+                return slot;
+            }
+            slot = (slot + 1) & (keys.length - 1);
+        }
+        return -1;
+    }
+
+    public boolean indexExists(int index) {
+        return index >= 0 && keys != null && index < keys.length && keys[index] != 0;
+    }
+
+    public int indexGet(int index) {
+        return indexExists(index) ? keys[index] : 0;
+    }
+
+    public int indexReplace(int index, int value) {
+        int old = indexGet(index);
+        if (old != 0) {
+            keys[index] = value;
+        } else {
+            add(value);
+        }
+        return old;
+    }
+
+    public void indexInsert(int index, int value) {
+        add(value);
+    }
+
+    public void indexRemove(int index) {
+        if (indexExists(index)) {
+            remove(keys[index]);
+        }
+    }
+
+    public String visualizeKeyDistribution(int characters) {
+        return "";
+    }
+
+    @Override
+    public long ramBytesAllocated() {
+        return keys == null ? 0 : (long) keys.length * Integer.BYTES;
+    }
+
+    @Override
+    public long ramBytesUsed() {
+        return ramBytesAllocated();
+    }
+
+    @Override
+    public IntHashSet clone() {
+        IntHashSet result = new IntHashSet(0, loadFactor);
+        result.keys = keys == null ? null : keys.clone();
+        result.size = size;
+        result.assigned = assigned;
+        result.hasEmptyKey = hasEmptyKey;
+        return result;
+    }
+
+    @Override
+    public int hashCode() {
+        int result = hasEmptyKey ? 1 : 0;
+        for (int value : keys) {
+            if (value != 0) {
+                result += value;
+            }
+        }
+        return result;
+    }
+
+    @Override
+    public boolean equals(Object obj) {
+        if (obj == this) {
+            return true;
+        }
+        if (!(obj instanceof IntContainer)) {
+            return false;
+        }
+        IntContainer other = (IntContainer) obj;
+        if (size != other.size()) {
+            return false;
+        }
+        for (IntCursor value : other) {
+            if (!contains(value.value)) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private int slot(int value) {
+        return mix(value) & (keys.length - 1);
+    }
+
+    private void insert(int value) {
+        int slot = slot(value);
+        while (keys[slot] != 0) {
+            slot = (slot + 1) & (keys.length - 1);
+        }
+        keys[slot] = value;
+        assigned++;
+    }
+
+    private void rehash() {
+        int[] oldKeys = keys;
+        keys = new int[oldKeys.length];
+        assigned = 0;
+        for (int value : oldKeys) {
+            if (value != 0) {
+                insert(value);
+            }
+        }
+    }
+
+    private static int mix(int value) {
+        value *= -1640531527;
+        return value ^ (value >>> 16);
+    }
+}
