+ *  distributed under the License is distributed on an "AS IS" BASIS,
+ *  WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ *  See the License for the specific language governing permissions and
+ *  limitations under the License.
+ */
+
+package org.teavm.javac;
+
+import java.util.ArrayList;
+import org.teavm.model.AccessLevel;
+import org.teavm.model.ClassHierarchy;
+import org.teavm.model.ClassHolder;
+import org.teavm.model.ClassReaderSource;
+import org.teavm.model.ElementModifier;
+import org.teavm.model.MethodDescriptor;
+import org.teavm.model.MethodHolder;
+import org.teavm.model.MethodReader;
+import org.teavm.model.emit.ProgramEmitter;
+
+final class EntryPointResolver {
+    private static MethodReader findMain(ClassReaderSource source, String className) {
+        var cls = source.get(className);
+        var descriptor = new MethodDescriptor("main", String[].class, void.class);
+        while (cls != null) {
+            var method = cls.getMethod(descriptor);
+            if (method != null) {
+                return method;
+            }
+            cls = cls.getParent() == null ? null : source.get(cls.getParent());
+        }
+        return null;
+    }
+
+    static String prepare(ClassReaderSource source, String className) {
+        if (source.get(className) == null) {
+            return "Could not find or load main class " + className;
+        }
+        var method = findMain(source, className);
+        if (method == null) {
+            return "Main method not found in class " + className;
+        }
+        return method.getLevel() == AccessLevel.PUBLIC && method.hasModifier(ElementModifier.STATIC)
+                ? null : "Main method must be public static void main(String[]) in class " + className;
+    }
+
+    static boolean needsLauncher(ClassReaderSource source, String className) {
+        var parent = source.get(className).getParent();
+        return parent != null && !parent.equals("java.lang.Object");
+    }
+
+    static ClassHolder launchClass(String className, String entryClass, String failure, ClassReaderSource source) {
+        var cls = new ClassHolder(className);
+        cls.setParent("java.lang.Object");
+        cls.setLevel(AccessLevel.PUBLIC);
+        var method = new MethodHolder(new MethodDescriptor("main", String[].class, void.class));
+        method.setLevel(AccessLevel.PUBLIC);
+        method.getModifiers().add(ElementModifier.STATIC);
+        cls.addMethod(method);
+        var emitter = ProgramEmitter.create(method, new ClassHierarchy(source));
+        if (failure != null) {
+            emitter.getField(System.class, "err", java.io.PrintStream.class)
+                    .invokeVirtual("println", emitter.constant("Error: " + failure));
+            emitter.construct("java.lang.NoSuchMethodError", emitter.constant(failure)).raise();
+        } else {
+            var ancestors = new ArrayList<String>();
+            for (var current = source.get(entryClass); current != null;
+                    current = current.getParent() == null ? null : source.get(current.getParent())) {
+                ancestors.add(current.getName());
+            }
+            for (int index = ancestors.size() - 1; index >= 0; index--) {
+                emitter.initClass(ancestors.get(index));
+            }
+            emitter.invoke(findMain(source, entryClass).getOwnerName(), "main", emitter.var(1, String[].class));
+            emitter.exit();
+        }
+        return cls;
+    }
+}
diff --git a/compiler/src/main/java/org/teavm/javac/WasiCompilerMain.java b/compiler/src/main/java/org/teavm/javac/WasiCompilerMain.java
new file mode 100644
index 0000000..b7672cf
--- /dev/null
+++ b/compiler/src/main/java/org/teavm/javac/WasiCompilerMain.java
@@ -0,0 +1,72 @@
+package org.teavm.javac;
+
+import org.teavm.interop.Import;
+
+/** Standalone Java-to-WASI compiler entrypoint used by WASM-OJ. */
+public final class WasiCompilerMain {
+    private WasiCompilerMain() {
+    }
+
+    public static void main(String[] args) {
+        procExit(run(args));
+    }
+
+    static int run(String[] args) {
+        if (args.length < 5) {
+            System.err.println("usage: java-compiler <sdk> <runtime-classlib> <main-class> <output> <source>...");
+            return 2;
+        }
+        try {
+            var compiler = new Compiler();
+            compiler.onDiagnostic(diagnostic -> {
+                var file = diagnostic.getFileName();
+                var line = diagnostic.getLineNumber() > 0 ? diagnostic.getLineNumber() : 1;
+                var column = diagnostic instanceof JavaDiagnostic javaDiagnostic
+                        && javaDiagnostic.getColumnNumber() > 0 ? javaDiagnostic.getColumnNumber() : 1;
+                var severity = diagnostic.getSeverity();
+                System.err.println((file == null ? "<java>" : file) + ":" + line + ":" + column + ": "
+                        + severity + ": " + diagnostic.getMessage());
+            });
+            var sdk = readFile(args[0]);
+            compiler.setSdkBytes(sdk);
+            var classlib = readFile(args[1]);
+            compiler.setTeaVMClasslibBytes(classlib);
+            for (int i = 4; i < args.length; i++) {
+                var name = args[i].replace('\\', '/');
+                if (name.startsWith("/project/")) name = name.substring("/project/".length());
+                var source = readFile(args[i]);
+                compiler.addSourceFileBytes(name, source);
+            }
+            var compiled = compiler.compile();
+            if (!compiled) {
+                return 1;
+            }
+            var generated = compiler.generateWebAssemblyForWasi(args[2], "app");
+            if (!generated) {
+                return 2;
+            }
+            var output = compiler.getWebAssemblyOutputBytes("app.wasm");
+            if (output == null) output = compiler.getWebAssemblyOutputBytes("app");
+            if (output == null) throw new IllegalStateException("TeaVM did not produce app.wasm");
+            writeFile(args[3], output);
+            var wast = compiler.getWebAssemblyOutputBytes("app.wast");
+            if (wast != null) writeFile(args[3] + ".wast", wast);
+            return 0;
+        } catch (Throwable e) {
+            System.err.println(e);
+            e.printStackTrace();
+            return 3;
+        }
+    }
+
+    private static byte[] readFile(String path) throws Exception {
+        return java.nio.file.Files.readAllBytes(java.nio.file.Path.of(path));
+    }
+
+    private static void writeFile(String path, byte[] data) throws Exception {
+        java.nio.file.Files.write(java.nio.file.Path.of(path), data);
+    }
+
+    @Import(name = "proc_exit", module = "wasi_snapshot_preview1")
+    private static native void procExit(int code);
+}
