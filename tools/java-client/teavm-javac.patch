diff --git a/compiler/src/classlibEmu/java/org/teavm/classlib/java/lang/TConsoleInputStream.java b/compiler/src/classlibEmu/java/org/teavm/classlib/java/lang/TConsoleInputStream.java
new file mode 100644
index 0000000..58b55f0
--- /dev/null
+++ b/compiler/src/classlibEmu/java/org/teavm/classlib/java/lang/TConsoleInputStream.java
@@ -0,0 +1,35 @@
+package org.teavm.classlib.java.lang;
+
+import java.io.IOException;
+import org.teavm.backend.wasm.runtime.WasiBuffer;
+import org.teavm.backend.wasm.wasi.IOVec;
+import org.teavm.backend.wasm.wasi.SizeResult;
+import org.teavm.backend.wasm.wasi.Wasi;
+import org.teavm.classlib.java.io.TInputStream;
+import org.teavm.interop.Address;
+import org.teavm.interop.Structure;
+
+class TConsoleInputStream extends TInputStream {
+    @Override
+    public int read(byte[] b, int off, int len) throws IOException {
+        if (len == 0) {
+            return 0;
+        }
+        var buffer = WasiBuffer.getBuffer();
+        IOVec vector = buffer.toStructure();
+        vector.buffer = Address.ofData(b).add(off);
+        vector.bufferLength = len;
+        SizeResult result = Address.align(buffer.add(Structure.sizeOf(IOVec.class)), 16).toStructure();
+        var errno = Wasi.fdRead(0, vector, 1, result);
+        if (errno != Wasi.ERRNO_SUCCESS) {
+            throw new IOException("fd_read: " + errno);
+        }
+        return result.value == 0 ? -1 : (int) result.value;
+    }
+
+    @Override
+    public int read() throws IOException {
+        var buffer = new byte[1];
+        return read(buffer, 0, 1) < 0 ? -1 : buffer[0] & 0xff;
+    }
+}
