+root=pathlib.Path(__file__).resolve().parents[3];build=root/'compiler/build';cp=(build/'gc-build-classpath.txt').read_text().strip();javac=str(args.jdk/'bin/javac');java=str(args.jdk/'bin/java')
+def run(*args):subprocess.run(args,check=True)
+def compile(destination,*sources):run(javac,'-cp',cp,'-d',str(destination),*[str(s) for s in sources])
+def read_archive(path):
+ data=path.read_bytes();result={};i=0
+ while i<len(data):
+  n=struct.unpack_from('>H',data,i)[0];i+=2;name=data[i:i+n].decode();i+=n;n=struct.unpack_from('>I',data,i)[0];i+=4;result[name]=data[i:i+n];i+=n
+ assert i==len(data)
+ return result
+def append_classes(result,path):
+ for file in sorted(path.rglob('*.class')):result[file.relative_to(path).as_posix()]=file.read_bytes()
+def write_archive(path,entries):
+ with path.open('wb') as out:
+  for name,data in sorted(entries.items()):
+   key=name.encode();out.write(struct.pack('>H',len(key))+key+struct.pack('>I',len(data))+data)
+classlib=build/'extended-classlib';platform=build/'extended-platform';compiler=build/'reliability-classes'
+compile(classlib,*[args.core/'classlib/src/main/java/org/teavm/classlib'/s for s in ['impl/JCLPlugin.java','impl/unicode/UnicodeSupport.java','impl/unicode/UnicodeHelper.java','java/lang/TLong.java','java/lang/TDouble.java','java/lang/TInteger.java','java/util/TLocale.java','java/util/TInputMismatchException.java','java/text/TDecimalFormat.java','java/text/TDecimalFormatParser.java','java/util/regex/TLexer.java']])
+compile(platform,*[args.core/'platform/src/main/java/org/teavm/platform/plugin'/s for s in ['PlatformPlugin.java','ResourceReadIntrinsic.java','EnumDependencySupport.java']])
+compile(compiler,root/'compiler/src/main/java/org/teavm/javac/StdlibConverter.java',root/'compiler/src/main/java/org/teavm/javac/TeaVMDiagnostic.java',root/'compiler/src/test/java/RelocateScanner.java')
+scanner=build/'android-scanner';scanner.mkdir(exist_ok=True)
+source=root/'compiler/src/scanner/java';run(javac,'--patch-module',f'java.base={source}','-d',str(scanner/'classes'),*[str(f) for f in sorted(source.rglob('*.java'))])
+run(java,'-cp',cp,'RelocateScanner',str(scanner/'classes'),str(scanner/'relocated'))
+converted=build/'extended-compile.bin';run(java,'-cp',cp,'org.teavm.javac.StdlibConverter',str(converted),str(classlib))
+sdk=read_archive(args.assets/'java-teavm-0.13.1.compile-classlib.bin');updates=read_archive(converted);updates.pop('module-info.class',None);sdk.update(updates);append_classes(sdk,scanner/'classes')
+runtime=read_archive(args.assets/'java-teavm-0.13.1.runtime-classlib.bin');append_classes(runtime,classlib);append_classes(runtime,scanner/'relocated')
+classlib_jar=next(pathlib.Path(entry) for entry in cp.split(':') if '/teavm-classlib/' in entry and entry.endswith('.jar'))
+with zipfile.ZipFile(classlib_jar) as jar:
+ data=jar.read('org/teavm/classlib/impl/unicode/cldr-json.zip')
+runtime['org/teavm/classlib/impl/unicode/cldr-json.zip']=data
