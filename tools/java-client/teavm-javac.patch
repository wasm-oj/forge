diff --git a/compiler/src/test/js/package-static-gc.mjs b/compiler/src/test/js/package-static-gc.mjs
new file mode 100644
index 0000000..2a391e4
--- /dev/null
+++ b/compiler/src/test/js/package-static-gc.mjs
@@ -0,0 +1,34 @@
+import { readFile, writeFile } from 'node:fs/promises';
+import { resolve } from 'node:path';
+
+const [core, directory] = process.argv.slice(2).map(path => resolve(path));
+if (!core || !directory) throw new Error('Expected TeaVM source root and compiler output directory');
+const module = await WebAssembly.compile(await readFile(`${directory}/java-compiler.wasm`));
+const entries = [];
+for (let index = 0; ; index++) {
+  const sections = WebAssembly.Module.customSections(module, `teavm.js-body.${index}`);
+  if (!sections.length) break;
+  if (sections.length !== 1) throw new Error('Duplicate JavaScript body section');
+  const bytes = Buffer.from(sections[0]);
+  let offset = 0;
+  const readNumber = () => { const number = bytes.readUInt32BE(offset); offset += 4; return number; };
+  const count = readNumber();
+  const parts = [];
+  for (let part = 0; part < count; part++) {
+    const length = readNumber();
+    if (length > bytes.length - offset) throw new Error('Truncated JavaScript body section');
+    parts.push(bytes.subarray(offset, offset + length).toString('utf8'));
+    offset += length;
+  }
+  if (!parts.length || offset !== bytes.length) throw new Error('Invalid JavaScript body section');
+  const parameters = parts.slice(0, -1);
+  if (parameters.some(name => !/^[A-Za-z_$][A-Za-z0-9_$]*$/.test(name))) throw new Error('Invalid parameter name');
+  entries.push(`[${JSON.stringify(JSON.stringify(parts))}, function(wrapCallFromJavaToJs${parameters.length ? ',' : ''}${parameters.join(',')}) {\n${parts.at(-1)}\n}]`);
+}
+if (!entries.length) throw new Error('Compiler has no statically emitted JavaScript bodies');
+await writeFile(`${directory}/java-compiler-bindings.mjs`, `// Generated from TeaVM compiler JSBody custom sections. Do not edit.\nexport const jsBodyFactories = new Map([\n${entries.join(',\n')}\n]);\n`);
+const runtime = await readFile(`${core}/core/src/main/js/wasm-gc-runtime/runtime.js`, 'utf8');
+if (/\bnew\s+Function\s*\(|\beval\s*\(/.test(runtime)) throw new Error('Runtime requires JavaScript string evaluation');
+await writeFile(`${directory}/java-compiler-runtime.mjs`, `${runtime}\nexport { load, defaults, wrapImport, hasStringBuiltins };
+export const compileJavaModule = bytes => WebAssembly.compile(bytes, { builtins: ["js-string"] });\n`);
+console.log(`Packaged ${entries.length} static JavaScript bodies`);
