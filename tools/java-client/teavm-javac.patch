+import { WASI } from 'node:wasi';
+import { readFile } from 'node:fs/promises';
+
+const [wasmPath, classlibDirectory, projectDirectory, mainClass = 'Main'] = process.argv.slice(2);
+const wasi = new WASI({
+  version: 'preview1',
+  args: ['java-compiler', '/toolchain/java-teavm-0.13.1.compile-classlib.bin',
+    '/toolchain/java-teavm-0.13.1.runtime-classlib.bin', mainClass, '/project/app.wasm', '/project/Main.java'],
+  preopens: { '/toolchain': classlibDirectory, '/project': projectDirectory },
+  returnOnExit: true,
+});
+const { instance } = await WebAssembly.instantiate(await readFile(wasmPath), wasi.getImportObject());
+process.exitCode = wasi.start(instance);
