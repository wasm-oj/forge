+import java.nio.file.*;
+import org.teavm.asm.ClassReader;
+import org.teavm.asm.ClassWriter;
+import org.teavm.asm.commons.ClassRemapper;
+import org.teavm.asm.commons.Remapper;
+public class RelocateScanner {
+ public static void main(String[] args)throws Exception {
+  var input=Path.of(args[0]);var out=Path.of(args[1]);
+  try(var files=Files.walk(input)){
+   for(var file:files.filter(Files::isRegularFile).toList()){
+    var writer=new ClassWriter(0);
+    new ClassReader(Files.readAllBytes(file)).accept(new ClassRemapper(writer,new Remapper(){
+     public String map(String name){return name.startsWith("java/util/Scanner") || name.startsWith("java/util/Spliterators")
+      ? name.replace("java/util/", "org/teavm/classlib/java/util/T") : name;}
+    }),0);
+    var target=out.resolve(input.relativize(file).toString().replace("java/util/", "org/teavm/classlib/java/util/T"));
+    Files.createDirectories(target.getParent());Files.write(target,writer.toByteArray());
+   }
+  }
+ }
+}
